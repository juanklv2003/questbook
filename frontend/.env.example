# ─────────────────────────────────────────────
# QuestBook — Frontend .env.example
# Copia este archivo a .env y completa los valores.
# ─────────────────────────────────────────────

# URL base del backend Express (dev local)
VITE_API_URL=http://localhost:3000/api/v1

# --- Cloudflare Turnstile (verificacion humana en el registro) ---
# Crea el sitio en https://dash.cloudflare.com/?to=/:account/turnstile y pega la Site Key PUBLICA aca.
# Sin esta key el form de registro muestra un aviso en vez del widget (y el boton queda deshabilitado).
VITE_TURNSTILE_SITE_KEY=