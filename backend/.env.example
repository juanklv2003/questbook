# ─────────────────────────────────────────────
# QuestBook — Backend .env.example
# Copia este archivo a .env y completa los valores.
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# --- PostgreSQL / Neon ---
# Obténla en https://console.neon.tech → Connection details
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require&channel_binding=require

# --- Google Gemini AI ---
# Obténla en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: más claves de la MISMA cuenta (separadas por comas). Failover en 429.
# Ej.: GEMINI_API_KEYS=otra_key_mismo_proyecto
GEMINI_API_KEYS=
# Opcional: clave de OTRO correo/proyecto en AI Studio (segundo cupo ~250 req/día free).
# Se prueba al final, cuando se agotan GEMINI_API_KEY + GEMINI_API_KEYS.
GEMINI_API_KEY2=

# --- Groq (respaldo opcional tras agotar cuota Gemini) ---
# API key: https://console.groq.com/keys
GROQ_API_KEY=
# Modelo OpenAI-compatible (default: openai/gpt-oss-20b). Si tenías llama-3.3-70b-versatile, cámbialo.
# GROQ_MODEL=openai/gpt-oss-20b

# Caracteres del PDF que se envían a la IA (default 500000, máx. 500000).
# PDF_MAX_TEXT_CHARS=500000
# Timeout ms al generar mazo (default 120000, máx. 300000). Subir si el PDF es muy largo.
# AI_DECK_TIMEOUT_MS=180000

# Tamaño máximo del PDF subido (MB, default 100, máx. 100). El archivo se carga en RAM del servidor.
# MAX_PDF_UPLOAD_MB=100
# Conexiones máximas al pool Postgres (default 10).
# DB_POOL_MAX=10

# --- JWT (auth de usuario) ---
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# --- CORS ---
# Origen EXACTO del frontend, sin barra final (ej. https://andel.vercel.app).
# En producción DEBE ser el dominio real: si no coincide, el navegador bloquea
# las peticiones (error de CORS) y además no se comparte la cookie de sesión.
FRONTEND_URL=http://localhost:5173

# --- CORS extra (opcional) ---
# Orígenes ADICIONALES permitidos, separados por comas (sin barra final).
# FRONTEND_URL siempre se incluye. Sirve para los preview deployments de Vercel
# (https://mi-app-git-rama-usuario.vercel.app) o para un dominio propio extra.
# CORS_ORIGINS=https://mi-app-git-rama-usuario.vercel.app,https://mi-dominio.com

# --- Cookies de sesión ---
# Con NODE_ENV=production la cookie se marca `secure` (requiere HTTPS) y, si no
# definís COOKIE_SAME_SITE, se usa SameSite=None.
#   none   → frontend y backend en dominios distintos (Vercel + Render/Railway)
#   lax    → mismo dominio o subdominios del mismo dominio (app.x.com + api.x.com)
#   strict → como lax, más restrictivo (solo navegación del mismo sitio)
# Omitir (o dejar vacío) para el default automático (none en prod, lax en dev).
# COOKIE_SAME_SITE=lax

# --- Cloudinary (PDFs) ---
# Obténlas creando una cuenta gratis en https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional: preset firmado para subidas desde el navegador (Upload → Add upload preset → Signing: Signed).
# Si la subida devuelve 400/401, créalo y pon el nombre aquí (ej. questbook_pdf).
# CLOUDINARY_PDF_UPLOAD_PRESET=questbook_pdf
# Límite por archivo en la API de Cloudinary (plan free ≈ 10 MB). Default en código: 10.
# CLOUDINARY_MAX_PDF_MB=10
# URL pública del API para PDFs grandes (navegador → Render, sin pasar por Vercel):
# API_PUBLIC_BASE_URL=https://flashcards-ia-api.onrender.com/api/v1
# Solo si tu cuenta usa carpetas fijas (legacy): CLOUDINARY_UPLOAD_FOLDER_MODE=legacy

# --- Cloudflare Turnstile (verificacion humana en el registro) ---
# Crea el sitio en https://dash.cloudflare.com/?to=/:account/turnstile y pega el Secret Key ACA (nunca en el frontend).
# El endpoint POST /auth/register lo exige: sin token valido responde 400.
TURNSTILE_SECRET_KEY=

# --- Google OAuth ---
# Obtén estas credenciales en https://console.cloud.google.com/apis/credentials
# Tipo de cliente: "Aplicación web" (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con un "URI de redireccionamiento autorizado" en Google Console.
# Dev (Vite proxy): http://localhost:5173/api/v1/auth/google/callback
# Prod: https://<TU-API>/api/v1/auth/google/callback (HTTPS obligatorio; no uses el dominio de Vercel aquí)
GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback
#
# Google Console — dev (http solo localhost):
#   Orígenes JS: http://localhost:5173
#   Redirect:    http://localhost:5173/api/v1/auth/google/callback
# Google Console — prod (HTTPS obligatorio, sin http:// en dominios públicos):
#   Orígenes JS: https://myquestbook.vercel.app
#   Redirect:    https://<tu-api-en-render>/api/v1/auth/google/callback