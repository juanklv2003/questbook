# ─────────────────────────────────────────────
# FlashyIA (Andel) — Backend .env.example
# Copia este archivo a .env y completa los valores.
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# --- PostgreSQL / Neon ---
# Obténla en https://console.neon.tech → Connection details
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require&channel_binding=require

# --- Google Gemini AI ---
# Obténla en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: claves adicionales separadas por comas para failover automático.
# Si una clave agota su cuota (429), la aplicación salta automáticamente a la siguiente.
# Ej.: GEMINI_API_KEYS=clave2,clave3
GEMINI_API_KEYS=

# --- JWT (auth de usuario) ---
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# --- CORS ---
# Origen EXACTO del frontend, sin barra final (ej. https://andel.vercel.app).
# En producción DEBE ser el dominio real: si no coincide, el navegador bloquea
# las peticiones (error de CORS) y además no se comparte la cookie de sesión.
FRONTEND_URL=http://localhost:5173

# --- Cookies de sesión ---
# Con NODE_ENV=production la cookie se marca `secure` (requiere HTTPS) y, si no
# definís COOKIE_SAME_SITE, se usa SameSite=None.
#   none   → frontend y backend en dominios distintos (Vercel + Render/Railway)
#   lax    → mismo dominio o subdominios del mismo dominio (app.x.com + api.x.com)
#   strict → como lax, más restrictivo (solo navegación del mismo sitio)
# Omitir (o dejar vacío) para el default automático (none en prod, lax en dev).
# COOKIE_SAME_SITE=lax

# --- Cloudinary (PDFs) ---
# Obténlas creando una cuenta gratis en https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=